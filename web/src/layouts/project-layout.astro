---
import BaseLayout from "./base-layout.astro";

const { title, description, status, repository } = Astro.props;
---

<BaseLayout title={`${title} | PixelBrewer`}>
  <article>
    <header>
      <h1>{title}</h1>
      <p>{description}</p>
      <p>{status}</p>

      {
        repository && (
          <a href={repository}>
            View repository
          </a>
        )
      }
    </header>

    <slot />
  </article>
</BaseLayout>
