---
import "../styles/global.css";

const { title = "PixelBrewer" } = Astro.props;
---

<!doctype html>
<html lang="en" class="mocha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-ctp-base text-ctp-text">
    <div class="mx-auto flex min-h-screen max-w-3xl flex-col px-6">
      <header class="flex items-center justify-between py-8">
        <a
          href="/"
          class="font-semibold text-ctp-text transition-colors hover:text-ctp-blue"
        >
          PixelBrewer
        </a>

        <nav class="flex gap-6 text-sm">
          <a
            href="/writing"
            class="text-ctp-subtext0 transition-colors hover:text-ctp-blue"
          >
            Writing
          </a>

          <a
            href="/projects"
            class="text-ctp-subtext0 transition-colors hover:text-ctp-blue"
          >
            Projects
          </a>

          <a
            href="/about"
            class="text-ctp-subtext0 transition-colors hover:text-ctp-blue"
          >
            About
          </a>
        </nav>
      </header>

      <main class="flex-1 py-12">
        <slot />
      </main>

      <footer class="border-t border-ctp-surface0 py-8 text-sm text-ctp-overlay1">
        <p>Built by Alex Blair.</p>
      </footer>
    </div>
  </body>
</html>
