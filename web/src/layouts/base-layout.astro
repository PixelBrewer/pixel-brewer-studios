---
import "../styles/global.css";
import { siGithub, siMastodon, siX } from "simple-icons";

const { title = "PixelBrewer" } = Astro.props;
---

<!doctype html>
<html lang="en" class="mocha">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/icons/pixelbrewer-mug.svg"
        />
        <title>{title}</title>
    </head>

    <body class="min-h-screen bg-ctp-base text-ctp-text">
        <div class="mx-auto flex min-h-screen max-w-3xl flex-col px-6">
            <header class="flex items-center justify-between py-8">
                <a
                    href="/"
                    class="flex items-center gap-2 font-semibold text-ctp-text transition-colors hover:text-ctp-blue"
                >
                    <img
                        src="/icons/pixelbrewer-mug.svg"
                        alt=""
                        class="size-9"
                        aria-hidden="true"
                    />

                    <span>PixelBrewer</span>
                </a>
                <nav class="flex gap-6 text-sm">
                    <a href="/writing">Writing</a>
                    <a href="/projects">Projects</a>
                    <a href="/about">About</a>
                    <a href="/gallery">Gallery</a>
                </nav>
            </header>

            <main class="flex-1 py-12">
                <slot />
            </main>
            <footer class="mt-auto border-t border-ctp-surface0">
                <div
                    class="mx-auto flex max-w-3xl items-center justify-between px-6 py-8 text-sm text-ctp-subtext0"
                >
                    <p>&copy; {new Date().getFullYear()} Alex Blair</p>

                    <div class="flex items-center gap-5">
                        <!-- Email -->
                        <a
                            href="mailto:YOUR_EMAIL_ADDRESS?subject=Hello%20from%20PixelBrewer"
                            aria-label="Email"
                            title="Email"
                            class="transition-colors hover:text-ctp-blue"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-5 fill-none stroke-current"
                            >
                                <path
                                    d="M3 6.75A1.75 1.75 0 0 1 4.75 5h14.5A1.75 1.75 0 0 1 21 6.75v10.5A1.75 1.75 0 0 1 19.25 19H4.75A1.75 1.75 0 0 1 3 17.25V6.75Z"
                                    stroke-width="1.75"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path>
                                <path
                                    d="m4 7 8 6 8-6"
                                    stroke-width="1.75"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path>
                            </svg>
                        </a>

                        <!-- GitHub -->
                        <a
                            href="https://github.com/PixelBrewer"
                            aria-label="GitHub"
                            title="GitHub"
                            class="transition-colors hover:text-ctp-blue"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-5 fill-current"
                            >
                                <path d={siGithub.path}></path>
                            </svg>
                        </a>

                        <!-- LinkedIn -->
                        <a
                            href="https://www.linkedin.com/in/alexanderjblair/"
                            aria-label="LinkedIn"
                            title="LinkedIn"
                            class="transition-colors hover:text-ctp-blue"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-5 fill-current"
                            >
                                <path
                                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.047c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9H7.12v11.452z"
                                ></path>
                            </svg>
                        </a>

                        <!-- Mastodon -->
                        <a
                            href="https://mastodon.social/@Pixelbrewer"
                            aria-label="Mastodon"
                            title="Mastodon"
                            class="transition-colors hover:text-ctp-blue"
                            target="_blank"
                            rel="me noopener noreferrer"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-5 fill-current"
                            >
                                <path d={siMastodon.path}></path>
                            </svg>
                        </a>

                        <!-- X -->
                        <a
                            href="https://x.com/PixlBrewer"
                            aria-label="X"
                            title="X"
                            class="transition-colors hover:text-ctp-blue"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-5 fill-current"
                            >
                                <path d={siX.path}></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </footer>
        </div>
    </body>
</html>
