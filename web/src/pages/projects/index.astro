---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/base-layout.astro";

const projects = await getCollection("projects");
---

<BaseLayout title="Projects | PixelBrewer">
  <section class="mb-10">
    <h1 class="text-4xl font-bold tracking-tight text-ctp-text">
      Projects
    </h1>

    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ctp-subtext0">
      Things I'm building, exploring, and learning from.
    </p>
  </section>

  <ul class="space-y-10">
    {
      projects.map((project) => (
        <li>
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-xl font-semibold">
              <a
                href={`/projects/${project.id}`}
                class="text-ctp-blue transition-colors hover:text-ctp-sapphire"
              >
                {project.data.title}
              </a>
            </h2>

            <span class="text-sm text-ctp-sapphire">
              {project.data.status}
            </span>
          </div>

          <p class="mt-2 max-w-2xl leading-relaxed text-ctp-subtext0">
            {project.data.description}
          </p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
